{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeskGrade local GradeResult contract v1",
  "description": "本地校验契约。供应商适配器应转换到其支持的Schema子集，不可假定可原样提交所有关键字。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "readability",
    "studentText",
    "criteria",
    "issues"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "SCORED",
        "UNABLE"
      ]
    },
    "readability": {
      "type": "string",
      "enum": [
        "CLEAR",
        "PARTIAL",
        "UNREADABLE"
      ]
    },
    "studentText": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 16000
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterionId",
          "awarded",
          "evidence",
          "reason"
        ],
        "properties": {
          "criterionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "awarded": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "SCORED"
          }
        }
      },
      "then": {
        "properties": {
          "readability": {
            "enum": [
              "CLEAR",
              "PARTIAL"
            ]
          },
          "studentText": {
            "type": "string"
          },
          "criteria": {
            "items": {
              "properties": {
                "awarded": {
                  "type": "number"
                }
              }
            }
          },
          "issues": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "UNABLE"
          }
        }
      },
      "then": {
        "properties": {
          "criteria": {
            "items": {
              "properties": {
                "awarded": {
                  "type": "null"
                }
              }
            }
          },
          "issues": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
